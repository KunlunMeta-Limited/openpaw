# OpenPaw 真实模型配置模板。复制为 .env 后填写密钥；.env 已被 .gitignore 排除。
OPENPAW_PROVIDER=openai
OPENAI_API_KEY=
OPENPAW_OPENAI_BASE_URL=https://api.openai.com/v1
OPENPAW_OPENAI_MODEL=gpt-4o

# 可选：使用 Anthropic 时配置以下三项，并将 OPENPAW_PROVIDER 改为 anthropic。
# ANTHROPIC_API_KEY=
# OPENPAW_ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENPAW_ANTHROPIC_MODEL=claude-sonnet-4

# 可选：人工审批模式。留空表示使用默认自动流程。
OPENPAW_ENGINE_PERMISSIONS=

# 可选：源码不在默认同级目录时，由 Kunlun 启动脚本读取。
# OPENPAW_SOURCE_ROOT=D:/Workspace_bak/openpaw-main
# AI_OFFICE_SOURCE_ROOT=D:/Workspace_bak/ai-office-react-main

# OPENPAW_ENV_FILE 用来“定位本文件”，不能依靠写在本文件内生效；非默认位置请通过
# start-demo-native.ps1 -EnvFile、start-demo.ps1 -EnvFile 或进程环境显式传入。
