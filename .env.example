# 复制到OpenPaw数据目录/.env，填写后重启程序。不要提交真实密钥。
# DeepSeek通过OpenAI兼容协议接入；base URL不含/chat/completions。
OPENPAW_PROVIDER=openai
OPENPAW_MODEL=deepseek-chat
OPENPAW_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=replace_with_your_deepseek_api_key

# Anthropic示例：修改上面的Provider/模型/地址，并改用ANTHROPIC_API_KEY。
# OPENPAW_PROVIDER=anthropic
# OPENPAW_MODEL=claude-sonnet-4
# OPENPAW_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
