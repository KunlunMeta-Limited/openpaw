{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaw.local/contracts/host-message-events-v1.schema.json",
  "title": "OpenCode v1 消息、删除与安全执行错误投影",
  "description": "CHG-2026-0022：只验证兼容消息投影，不改变 Gateway turns；错误详情不得包含原始响应、请求、凭据或路径。",
  "oneOf": [
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/message" }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data"],
      "properties": {
        "name": { "enum": ["APIError", "UnknownError"] },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "code", "isRetryable"],
          "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 512 },
            "code": { "type": "string", "minLength": 1 },
            "isRetryable": { "type": "boolean" },
            "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 },
            "providerID": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" }
          }
        }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionID", "role", "time"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sessionID": { "type": "string", "minLength": 1 },
        "role": { "enum": ["user", "assistant"] },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "created": { "type": "integer" }, "completed": { "type": ["integer", "null"] } }
        },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "textPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "messageID", "sessionID", "type", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "messageID": { "type": "string", "minLength": 1 },
        "sessionID": { "type": "string", "minLength": 1 },
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info", "parts"],
      "properties": { "info": { "$ref": "#/$defs/info" }, "parts": { "type": "array", "items": { "type": "object" } } }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "message.removed" },
            "properties": {
              "type": "object", "additionalProperties": false, "required": ["sessionID", "messageID"],
              "properties": { "sessionID": { "type": "string", "minLength": 1 }, "messageID": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "session.error" },
            "properties": {
              "type": "object", "additionalProperties": false, "required": ["sessionID", "error"],
              "properties": { "sessionID": { "type": "string", "minLength": 1 }, "error": { "$ref": "#/$defs/error" } }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "message.updated" },
            "properties": {
              "type": "object", "additionalProperties": false, "required": ["info"],
              "properties": { "info": { "$ref": "#/$defs/info" } }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "message.part.updated" },
            "properties": {
              "type": "object", "additionalProperties": false, "required": ["part"],
              "properties": { "part": { "$ref": "#/$defs/textPart" } }
            }
          }
        }
      ],
      "properties": { "type": { "type": "string" }, "properties": { "type": "object" } }
    }
  }
}
