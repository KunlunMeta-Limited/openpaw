{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaw.local/contracts/host-prompt-v1.schema.json",
  "title": "OpenPaw 文字与内联媒体输入",
  "description": "CHG-2026-0026：直接 text 优先；file 原件单图5 MiB/单音频20 MiB、单回合4个且20 MiB。非法媒体400、原件或body超限413，接收前拒绝；模型能力不匹配400。远程URL不下载。 CHG-2026-0027：text part 支持可选 synthetic 和 metadata 对象；带属性时保留独立边界，属性随消息原子保存。",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "mime",
              "url"
            ],
            "properties": {
              "type": {
                "const": "file"
              },
              "mime": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp",
                  "image/gif",
                  "audio/wav",
                  "audio/x-wav",
                  "audio/mpeg",
                  "audio/mp3"
                ]
              },
              "filename": {
                "type": "string",
                "maxLength": 255
              },
              "url": {
                "type": "string",
                "pattern": "^data:[^;]+;base64,[A-Za-z0-9+/]*={0,2}$"
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "synthetic": {
                "type": "boolean"
              },
              "metadata": {
                "type": "object"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "file",
                    "text"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "requestID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "messageID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "object",
      "properties": {
        "providerID": {
          "type": "string"
        },
        "modelID": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "text"
      ]
    },
    {
      "required": [
        "parts"
      ]
    }
  ]
}
