/target-msrv*/
**/*.rs.bk

# Cargo
Cargo.lock.orig

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Test / scratch output
*.log
/g_*.txt
/verify_fmt.txt
/scrub_result.txt

# Isolated Host contract checks (not production dependencies)
/tests/engine-host-contracts/node_modules
/tests/engine-host-contracts/.upstream/

# Python governance caches
__pycache__/
*.pyc

# Local development records; public runtime/setup inputs remain under docs.
/docs/*
!/docs/engine-host/
/docs/engine-host/*
!/docs/engine-host/contracts/
!/docs/engine-host/host-config.example.toml
/docs/engine-host/contracts/*
!/docs/engine-host/contracts/sources.json
/governance/
